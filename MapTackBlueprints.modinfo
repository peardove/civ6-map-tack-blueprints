<?xml version="1.0" encoding="utf-8"?>
<Mod id="f5384cc1-8254-4930-9f6b-baf6c99572be" version="1">
  <Properties>
    <Name>Map Tack Blueprints</Name>
    <Authors>peardove</Authors>
    <Teaser>Import reusable map-tack planning blueprints.</Teaser>
    <Description>Imports named city and district planning blueprints as native Civilization VI map tacks. Includes Australia plans for the official Huge True Start Location Earth map and integrates with Detailed Map Tacks when installed.</Description>
    <AffectsSavedGames>0</AffectsSavedGames>
    <CompatibleVersions>1.2,2.0</CompatibleVersions>
  </Properties>

  <InGameActions>
    <AddUserInterfaces id="mtb_ingame_ui">
      <Properties>
        <Context>InGame</Context>
        <LoadOrder>13000</LoadOrder>
      </Properties>
      <File>ui/MapTackBlueprints.xml</File>
    </AddUserInterfaces>
    <UpdateText id="mtb_text">
      <File Priority="1">text/MapTackBlueprints_en_US.xml</File>
      <File>text/MapTackBlueprints_zh_Hans_CN.xml</File>
    </UpdateText>
    <ImportFiles id="mtb_import_files">
      <File>blueprints/TSLHugeAustralia.lua</File>
      <File>ui/MapTackBlueprints.lua</File>
      <File>ui/MapTackBlueprints.xml</File>
    </ImportFiles>
  </InGameActions>

  <Files>
    <File>blueprints/TSLHugeAustralia.lua</File>
    <File>text/MapTackBlueprints_en_US.xml</File>
    <File>text/MapTackBlueprints_zh_Hans_CN.xml</File>
    <File>ui/MapTackBlueprints.lua</File>
    <File>ui/MapTackBlueprints.xml</File>
  </Files>
</Mod>
